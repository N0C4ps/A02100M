---
interface Resources {
  audio?: string;
  notas?: string;
  slides?: string;
  pdf?: string;
  googleSlides?: string;
  legendas?: string;
  transcricao?: string;
  video?: string;
  shorts?: string;
}

interface Props {
  resources?: Resources;
}

const { resources } = Astro.props;

const labels: Record<keyof Resources, string> = {
  video: '🎬 Vídeo',
  shorts: '📱 Shorts',
  audio: '🎧 Áudio',
  notas: '📝 Notas',
  slides: '🖥️ Slides',
  pdf: '📄 PDF',
  googleSlides: '📊 Google Slides',
  legendas: '💬 Legendas',
  transcricao: '📃 Transcrição',
};

const entries = resources
  ? (Object.entries(resources) as [keyof Resources, string][]).filter(([, url]) => Boolean(url))
  : [];
---

{entries.length > 0 && (
  <div class="flex flex-wrap gap-2 mt-2">
    {entries.map(([key, url]) => (
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 rounded-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-3 py-1 text-xs font-medium text-slate-700 dark:text-slate-200 hover:border-blue-500 hover:text-blue-600 transition-colors"
      >
        {labels[key]}
      </a>
    ))}
  </div>
)}
